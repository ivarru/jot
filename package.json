{
  "name": "jot",
  "version": "0.21.5",
  "description": "A static progressive web app for personal Daily Notes.",
  "private": true,
  "license": "MIT",
  "author": "Ivar Rummelhoff",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivarru/jot.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "build:pages": "export BASE_PATH=${BASE_PATH:-/jot/}; npm run build && node scripts/prepare-pages.mjs",
    "verify": "npm run test && npm run typecheck && npm run build",
    "verify:full": "npm run verify && npm run test:browser",
    "verify:pages": "npm run test && npm run typecheck && npm run test:browser && npm run build:pages && npm run test:artifact",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --outDir .output/public",
    "preview:test:fake": "node scripts/preview-test-fake-auth.mjs",
    "preview:test:oauth": "node scripts/preview-test-local-oauth.mjs",
    "test:browser": "playwright test tests/browser",
    "test:browser:editing": "playwright test tests/browser/editing",
    "test:browser:workflows": "playwright test tests/browser/workflows",
    "test:browser:raw-keyboard": "playwright test tests/browser/editing/raw-keyboard.spec.ts",
    "test:browser:wysiwyg-paste": "playwright test tests/browser/editing/wysiwyg-paste.spec.ts",
    "test:browser:code-block-layout": "playwright test tests/browser/editing/code-block-layout.spec.ts",
    "test:browser:toolbar-indent": "playwright test tests/browser/editing/toolbar-indent.spec.ts",
    "test:browser:link-modal": "playwright test tests/browser/workflows/link-modal.spec.ts",
    "test:browser:tagging": "playwright test tests/browser/workflows/tagging.spec.ts",
    "test:browser:daily-note-upload": "playwright test tests/browser/workflows/daily-note-upload.spec.ts",
    "test:browser:reconnect-conflict": "playwright test tests/browser/workflows/reconnect-conflict.spec.ts",
    "test:browser:image-upload": "playwright test tests/browser/workflows/image-upload.spec.ts",
    "test:browser:latex": "playwright test tests/browser/workflows/latex.spec.ts",
    "test:smoke": "playwright test tests/browser/smoke",
    "test:artifact": "PLAYWRIGHT_NO_WEBSERVER=true playwright test tests/artifact",
    "start": "vinxi start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@milkdown/kit": "^7.21.2",
    "@milkdown/plugin-automd": "7.21.2",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.1.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.11",
    "katex": "^0.17.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "solid-js": "^1.9.9",
    "ulid": "^3.0.1",
    "vinxi": "^0.5.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdast": "^4.0.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "h3": "1.15.11"
  }
}
